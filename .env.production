# Carregado pelo `next build` (NODE_ENV=production), tem prioridade sobre `.env`.
# NEXT_PUBLIC_* é inlinado no bundle no momento do build — por isso a URL de
# produção precisa estar aqui, e não só nas vars de runtime do wrangler.jsonc.
NEXT_PUBLIC_SERVER_URL=https://instituto-cavalus.suporte-fd8.workers.dev
